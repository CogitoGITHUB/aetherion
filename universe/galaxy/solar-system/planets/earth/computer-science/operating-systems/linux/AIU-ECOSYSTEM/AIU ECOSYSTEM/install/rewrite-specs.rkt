#lang racket/base
(require racket/file racket/string)
(define args (current-command-line-arguments))
(define root (vector-ref args 0))
(define in-dir (vector-ref args 1))
(define out-dir (vector-ref args 2))
(define pattern #px"[(]local \"[^\"]*AIU-ECOSYSTEM")
(make-directory* out-dir)
(for ([f (in-list (directory-list in-dir))] #:when (regexp-match? #rx"[.]rktd$" (path->string f)))
  (define text (file->string (build-path in-dir f)))
  (define n (length (regexp-match* pattern text)))
  (unless (= n 1)
    (printf "FAILED in ~a: found ~a local sources\n" f n)
    (exit 1))
  (display-to-file (regexp-replace pattern text (regexp-replace-quote (string-append "(local \"" root)))
                   (build-path out-dir f) #:exists (quote truncate)))
(printf "rewrote specs into ~a\n" out-dir)

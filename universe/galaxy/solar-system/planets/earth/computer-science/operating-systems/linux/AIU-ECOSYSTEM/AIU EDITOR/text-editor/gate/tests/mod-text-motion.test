test mod-text-motion
level 2
module editor/tui/text/text-motion.rkt
call (let ([b (string->bytes/utf-8 "ab cd\nefg\nh")]) (list (multi-left b 2) (multi-right b 2) (multi-line-start b 7) (multi-line-end b 7) (multi-col b 7) (multi-up b 7) (multi-down b 1) (multi-word-fwd b 0) (multi-word-back b 5) (multi-word-at b 4) (multi-word? 95)))
expect result equals (1 3 6 9 1 1 7 2 3 (3 . 5) #t)
expect seconds-under 20

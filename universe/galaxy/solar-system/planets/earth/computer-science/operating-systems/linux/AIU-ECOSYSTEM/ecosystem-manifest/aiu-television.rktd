  (build (steps (run #:argv ("nice" "-n" "19" "cargo" "build" "--release" "-j" "2" "--config" "profile.release.lto=false" "--target-dir" "target-television" "--manifest-path" "television/Cargo.toml" "--bin" "tv"))))

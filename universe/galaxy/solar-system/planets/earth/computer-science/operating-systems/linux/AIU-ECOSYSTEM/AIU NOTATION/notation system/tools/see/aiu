#!/usr/bin/env nu
# aiu: the everyday command for .aiu pages. With no file it opens tv to pick one.
#   aiu see [FILE|FOLDER] [--plain] [--contracts]   show a page, formatted, in the terminal
#   aiu open [FILE|FOLDER]            open a page in the editor named by AIU_EDITOR (else EDITOR)
#   aiu check|render|parse|roundtrip [FILE|FOLDER]
#   aiu pick [FOLDER]                 only print the chosen path
#   aiu update                        rebuild the binary and starter pages if local files changed
#   aiu list                          list the blocks and the file types
#   aiu gate                          run the light gate
#   aiu new TYPE FILE                 create a page from the starter of a type, then check it
#   aiu newtype NAME                  write a starter module for a new file type
# AIU_PICK_FIRST=1 skips tv and takes the first page (for scripts and checks).

# The project root is three folders above this file (tools/see/aiu).
const script_file = (path self)

# Asks one question in the terminal; returns an empty string when the person cancels with Ctrl-C or Esc.
def ask [prompt: string] {
  try { input $prompt | str trim } catch { "" }
}

# Prints the list of aiu commands with a one-line description each.
def aiu-help [] {
  print "aiu: AIU NOTATION command. Usage: aiu COMMAND [FILE] [--plain] [--contracts]"
  print ""
  [[command description];
    ["aiu see FILE [--contracts]" "view a page, formatted; --contracts adds its contract panel"]
    ["aiu open FILE" "open a page in your editor"]
    ["aiu check FILE" "check a page, list errors with line numbers"]
    ["aiu render FILE" "plain text render of a page"]
    ["aiu parse FILE" "print the parse tree"]
    ["aiu roundtrip FILE" "check the page prints back byte for byte"]
    ["aiu pick [FOLDER]" "pick a page with the tv picker, then view it"]
    ["aiu update" "rebuild the binary and regenerate type pages if needed"]
    ["aiu list" "list the blocks and the file types that exist now"]
    ["aiu gate" "run the light gate"]
    ["aiu new TYPE FILE" "new page from a type starter, checked"]
    ["aiu newtype NAME" "new file type module, then aiu update"]
  ] | print
}


# Opens the tv menu of aiu commands, then runs the chosen one (plain table if tv is missing).
def aiu-menu [] {
  if (which tv | is-empty) { aiu-menu; return }
  let root = (^readlink -f $script_file | str trim | path dirname | path dirname | path dirname)
  rm -f /tmp/aiu-cmd
  try { do { cd ($root | path join tools see cable); ^tv aiu-commands --cable-dir ($root | path join tools see cable)  --layout portrait --preview-size 80 } } catch {|e| if not ($e.msg | str contains "non-zero") { print $"tv failed: ($e.msg)" } }
  let choice = (if ("/tmp/aiu-cmd" | path exists) { open --raw /tmp/aiu-cmd | str trim | split row ";" | first | str trim --char (char single_quote) | str trim } else { "" })
  if ($choice | is-empty) { return }
  if $choice == "new" {
    rm -f /tmp/aiu-type
  try { do { cd ($root | path join tools see cable); ^tv aiu-types --cable-dir ($root | path join tools see cable)  --layout portrait --preview-size 80 } } catch {|e| if not ($e.msg | str contains "non-zero") { print $"tv failed: ($e.msg)" } }
    let t = (if ("/tmp/aiu-type" | path exists) { open --raw /tmp/aiu-type | str trim | split row ";" | first | str trim } else { "" })
    if ($t | is-empty) { return }
    let f = (ask "file: ")
    if ($f | is-empty) { return }
    ^nu $script_file new $t $f
  } else if $choice == "newtype" {
    let n = (ask "name: ")
    if not ($n | is-empty) { ^nu $script_file newtype $n }
  } else {
    ^nu $script_file $choice
  }
}

# Opens the tv lists: first the kind (blocks or file types), then the entries of that kind with details in the preview. The new-type and new-block entries start the guided creation.
def aiu-list-tv [] {
  let root = (^readlink -f $script_file | str trim | path dirname | path dirname | path dirname)
  rm -f /tmp/aiu-list-kind /tmp/aiu-list
  try { do { cd ($root | path join tools see cable); ^tv aiu-list-kind --cable-dir ($root | path join tools see cable)  --layout portrait --preview-size 80 } } catch {|e| if not ($e.msg | str contains "non-zero") { print $"tv failed: ($e.msg)" } }
  let kind = (if ("/tmp/aiu-list-kind" | path exists) { open --raw /tmp/aiu-list-kind | str trim | split row ";" | first | str trim } else { "" })
  if ($kind | is-empty) { return }
  if $kind == "blocks" {
  try { do { cd ($root | path join tools see cable); ^tv aiu-list-blocks --cable-dir ($root | path join tools see cable)  --layout portrait --preview-size 80 } } catch {|e| if not ($e.msg | str contains "non-zero") { print $"tv failed: ($e.msg)" } }
  } else {
  try { do { cd ($root | path join tools see cable); ^tv aiu-list-types --cable-dir ($root | path join tools see cable)  --layout portrait --preview-size 80 } } catch {|e| if not ($e.msg | str contains "non-zero") { print $"tv failed: ($e.msg)" } }
  }
  let pick = (if ("/tmp/aiu-list" | path exists) { open --raw /tmp/aiu-list | str trim } else { "" })
  if $pick == "new-type" { let n = (ask "name: "); if not ($n | is-empty) { ^nu $script_file newtype $n } }
  if $pick == "new-block" {
    let n = (ask "block name: ")
    if not ($n | is-empty) { do -i { ^bash ($root | path join tools see newblock-guide.sh) $n } }
  }
}

def main [cmd?: string, target?: path, extra?: string, --plain (-p), --contracts] {
    if ($cmd == null) { aiu-menu; return }
    if ($cmd == "list") and (not $plain) and (is-terminal --stdout) and (not (which tv | is-empty)) { aiu-list-tv; return }
  let root = (^readlink -f $script_file | str trim | path dirname | path dirname | path dirname)
  let bin = ($root | path join notation target debug notation)
  let cli = ($root | path join notation src entry cli.rkt)
  let view = ($root | path join tools see aiu)
  let rk = ($env.HOME | path join opt racket-full bin racket)
  let racket = ($env.AIU_RACKET? | default (if ($rk | path exists) { $rk } else { "racket" }))
  let known = ["check" "render" "parse" "roundtrip" "see" "open" "pick" "update" "list" "gate" "new" "newtype"]
  if not ($cmd in $known) {
    error make {msg: $"unknown command '($cmd)'. Use one of: ($known | str join ' ')"}
  }

  if $cmd == "update" {
    update-package $root $bin $racket
    return
  }
  if $cmd == "list" {
    list-package $root $racket
    return
  }
  if $cmd == "gate" {
    gate-package $root $bin
    return
  }
  if $cmd == "new" {
    new-page $root $racket $bin $target $extra
    return
  }
  if $cmd == "newtype" {
    new-type $root $racket $target
    return
  }

  mut file = ""
  if $target != null {
    let kind = ($target | path type)
    if $kind == "" {
      error make {msg: $"no such file or folder: ($target)"}
    }
    if $kind == "file" {
      $file = $target
    }
  }
  if $file == "" {
    let dir = (if $target != null { $target } else { $env.PWD })
    let all = (do { cd $dir; glob **/*.aiu | where {|p| not ($p | str contains "/target/") and not ($p | str contains "/.git/")} | sort })
    if ($all | is-empty) {
      print $"no .aiu pages found under ($dir)"
      return
    }
    if (($env.AIU_PICK_FIRST? | default "") != "") {
      $file = ($all | first)
    } else {
      if (which tv | is-empty) {
        error make {msg: "tv (television) is not on PATH. Install it, or give a file: aiu see FILE"}
      }
      rm -f /tmp/aiu-pick
      try { do { cd $dir; with-env {AIU_NOTATION_ROOT: $root} { ^tv aiu-pages --cable-dir ($root | path join tools see cable) --preview-size 80 } } } catch {|e| if not ($e.msg | str contains "non-zero") { print $"tv failed: ($e.msg)" } }
      let out = (if ("/tmp/aiu-pick" | path exists) { open --raw /tmp/aiu-pick | str trim } else { "" })
      if ($out | is-empty) {
        print "nothing chosen"
        return
      }
      $file = ($out | lines | first)
    }
  }
  let f = $file

  if $cmd == "pick" {
    print $f
  } else if $cmd == "see" {
    let cols = (try { term size | get columns } catch { 80 })
    let extra_flags = (if $contracts { ["--contracts"] } else { [] })
    with-env {LC_ALL: "C.UTF-8"} {
      if $plain {
        run-external ...(see-pair $racket $view $extra_flags) $f "--plain" ...$extra_flags "--width" ($cols | into string)
      } else {
        run-external ...(see-pair $racket $view $extra_flags) $f ...$extra_flags "--width" ($cols | into string)
      }
    }
  } else if $cmd == "open" {
    # The AIU editor opens a page first: it reads .aiu with the notation
    # engine built in. AIU_EDITOR and EDITOR are the fallback, so a machine
    # without aiutd still opens the page somewhere.
    let found = (try { which aiutd | get path.0 } catch { "" })
    let ed = (if ($found | is-empty) {
        ($env.AIU_EDITOR? | default ($env.EDITOR? | default ""))
      } else { $found })
    if ($ed | is-empty) {
      error make {msg: "no editor set. Put aiutd on PATH, or set AIU_EDITOR to its command."}
    }
    let parts = ($ed | split row " " | where {|p| $p != ""})
    run-external ($parts | first) ...($parts | skip 1) $f
  } else if $cmd == "check" {
    with-env {LC_ALL: "C.UTF-8", AIU_NOTATION_BIN: $bin} {
      run-external $racket $cli "check" $f
    }
  } else {
    with-env {LC_ALL: "C.UTF-8"} {
      run-external $bin $cmd $f
    }
  }
}

# update-package rebuilds what local changes left stale: the Rust binary, then the starter pages.
def update-package [root: string, bin: string, racket: string] {
  # upstream: the fetch step goes here, before the two steps below.
  let repo = ($root | path dirname)
  let raco = ($racket | path dirname | path join raco)
  if ($raco | path exists) {
    let c = (with-env {LC_ALL: "C.UTF-8"} { run-external $raco make ($root | path join notation src entry cli.rkt) ($root | path join notation src filetypes make-live.rkt) ($root | path join notation src filetypes dump-contracts.rkt) } | complete)
    if $c.exit_code != 0 { print $c.stderr; error make {msg: "raco: compile failed"} }
    print "raco: compiled"
  }

  let rust = (do { cd $root; glob notation/src/**/*.rs } | append [($root | path join notation Cargo.toml) ($root | path join notation Cargo.lock)])
  let newest_rust = ($rust | each {|p| ls $p | get modified | first } | sort | last)
  let bin_time = (if ($bin | path exists) { ls $bin | get modified | first } else { null })
  let stale_bin = (if $bin_time == null { true } else { $newest_rust > $bin_time })
  if $stale_bin {
    print "rust: changed, building"
    try { ^cargo build --manifest-path ($root | path join notation Cargo.toml) } catch { error make {msg: "rust: build failed"} }
    print "rust: built"
  } else {
    print "rust: up to date"
  }

  let sources = (do { cd $root; glob notation/src/filetypes/**/*.rkt })
  let newest_source = ($sources | each {|p| ls $p | get modified | first } | sort | last)
  let pages = (do { cd $repo; glob types/*.aiu })
  let oldest_page = (if ($pages | is-empty) { null } else { $pages | each {|p| ls $p | get modified | first } | sort | first })
  let stale_pages = (if $oldest_page == null { true } else { $newest_source > $oldest_page })
  if $stale_pages {
    let make = ($root | path join notation src filetypes make-live.rkt)
    let r = (with-env {LC_ALL: "C.UTF-8"} { run-external $racket $make } | complete)
    if $r.exit_code != 0 {
      print $r.stderr
      error make {msg: "pages: regenerating failed"}
    }
    print "pages: regenerated"
  } else {
    print "pages: up to date"
  }
}

# list-package prints the block names the parser knows and the file types that load.
def list-package [root: string, racket: string] {
  let parser = ($root | path join notation src parser parser.rs)
  let body = (open --raw $parser | lines | skip until {|l| $l | str contains "BLOCK_NAMES: ["} | skip 1 | take until {|l| ($l | str trim) == "];"})
  let names = ($body | str join " " | split row "\"" | enumerate | where {|x| ($x.index mod 2) == 1} | get item)

  let ft = ($root | path join notation src filetypes filetypes.rkt)
  let expr = ["(require (file \"" $ft "\") racket/string) (for ([(n t) (in-hash (load-file-types))]) (printf \"~a|~a|~a\" (file-type-name t) (file-type-description t) (let ([b (file-type-allowed-blocks t)]) (if b (string-join b \" \") \"*\"))) (newline))"] | str join
  let r = (with-env {LC_ALL: "C.UTF-8"} { run-external $racket "-e" $expr } | complete)
  if $r.exit_code != 0 {
    print $r.stderr
    error make {msg: "types: could not load the file types"}
  }
  let types = ($r.stdout | lines | each {|l| let p = ($l | split row "|"); {name: ($p | get 0), description: ($p | get 1), blocks: ($p | get 2)}} | sort-by name)

  let notes = {heading: "older; being replaced by section", table: "parsed only; check rejects it", header: "parsed only; check rejects it", row: "parsed only; check rejects it"}
  let blocks = ($names | each {|name|
    let users = ($types | where {|t| $t.blocks == "*" or ($t.blocks | split row " " | any {|b| $b == $name})} | get name | str join " ")
    {block: $name, note: (try { $notes | get $name } catch { "" }), allowed_in: $users}
  })

  print "blocks (read from parser.rs)"
  print $blocks
  print ""
  print "file types (read from the loader)"
  print ($types | update blocks {|t| if $t.blocks == "*" { "any" } else { $t.blocks }})
}

# gate-package runs the light gate from the package folder with the right environment.
def gate-package [root: string, bin: string] {
  cd $root
  with-env {LC_ALL: "C.UTF-8", AIU_NOTATION_BIN: $bin} { ^nu gate/check.nu }
}

# new-page copies the starter page of a file type to a new file and checks the copy.
def new-page [root: string, racket: string, bin: string, kind, file] {
  let repo = ($root | path dirname)
  let raco = ($racket | path dirname | path join raco)
  if ($raco | path exists) {
    let c = (with-env {LC_ALL: "C.UTF-8"} { run-external $raco make ($root | path join notation src entry cli.rkt) ($root | path join notation src filetypes make-live.rkt) ($root | path join notation src filetypes dump-contracts.rkt) } | complete)
    if $c.exit_code != 0 { print $c.stderr; error make {msg: "raco: compile failed"} }
    print "raco: compiled"
  }
  let starters = (do { cd $repo; glob types/*.aiu } | each {|p| $p | path parse | get stem } | sort)
  let names = ($starters | str join ", ")
  if ($kind == null) or ($file == null) {
    error make {msg: $"usage: aiu new TYPE FILE. Types: ($names)"}
  }
  let starter = ($repo | path join types $"($kind).aiu")
  if not ($starter | path exists) {
    error make {msg: $"no file type named ($kind). Types: ($names)"}
  }
  let dest = ($file | path expand)
  if ($dest | path exists) {
    error make {msg: $"($dest) already exists"}
  }
  cp $starter $dest
  let cli = ($root | path join notation src entry cli.rkt)
  let r = (with-env {LC_ALL: "C.UTF-8", AIU_NOTATION_BIN: $bin} { run-external $racket $cli "check" $dest } | complete)
  print $"created ($dest)"
  print (($r.stdout + $r.stderr) | str trim)
}

# new-type writes a starter module for a new file type and regenerates the starter pages.
def new-type [root: string, racket: string, name] {
  if $name == null {
    error make {msg: "usage: aiu newtype NAME"}
  }
  let n = ($name | into string)
  if not ($n =~ "^[a-z][a-z0-9-]*$") {
    error make {msg: "a type name is lowercase letters, digits and dashes, and starts with a letter"}
  }
  let dir = ($root | path join notation src filetypes types)
  let file = ($dir | path join $"($n).rkt")
  if ($file | path exists) or (($dir | path join $n) | path exists) {
    error make {msg: $"a file type named ($n) already exists"}
  }
  let lines = [
    "#lang racket/base"
    ";; NAME.rkt -- the file type \"NAME\": one line saying what it is for."
    ";; Called by: filetypes.rkt (found by scanning filetypes/types/)."
    "(require \"_base.rkt\")"
    "(provide the-type the-contracts)"
    ""
    ";; The NAME type."
    "(define the-type (file-type \"NAME\" \"edit this description\" (list \"title\" \"paragraph\")))"
    ""
    ";; The contracts of the NAME type. A rule is checked; a question is only reported."
    "(define the-contracts"
    "  (list (list 'rule \"*\" \"paragraph\" 'max-words 250)))"
  ]
  let text = ($lines | str join "\n" | str replace --all "NAME" $n)
  ($text + "\n") | save $file
  print $"wrote ($file)"
  update-package $root ($root | path join notation target debug notation) $racket
  print "next: set the description, the allowed blocks and the contracts in that file, then run aiu update"
}

# see-pair: the command that draws a page: the Rust view; for the contracts panel it first makes sure the data file is fresh.
# Called by: the see command above. Arguments: the Racket binary, this script path, the extra flags.
def see-pair [racket: string, view: string, flags: list] {
  let root = ($view | path dirname | path dirname | path dirname)
  let env_bin = ($env.AIU_NOTATION_BIN? | default "")
  let bin = (if ($env_bin | path exists) { $env_bin } else { $root | path join notation target debug notation })
  if ($flags | any {|x| $x == "--contracts"}) { refresh-contracts $root $racket }
  [$bin "view"]
}

# refresh-contracts: writes notation/target/contracts.dat when it is missing or older than a file type module.
# Called by: see-pair. Arguments: the project root, the Racket binary.
def refresh-contracts [root: string, racket: string] {
  let dat = ($root | path join notation target contracts.dat)
  let types = ($root | path join notation src filetypes)
  let stale = (if ($dat | path exists) { (^find $types -name "*.rkt" -newer $dat | str trim) != "" } else { true })
  if $stale {
    with-env {LC_ALL: "C.UTF-8"} { run-external $racket ($types | path join dump-contracts.rkt) $dat }
  }
}

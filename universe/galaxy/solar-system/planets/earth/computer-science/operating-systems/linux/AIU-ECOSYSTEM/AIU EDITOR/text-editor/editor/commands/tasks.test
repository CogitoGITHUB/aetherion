test mod-tasks
level 2
module editor/commands/tasks.rkt
call (list (task-say #f (list "a" "b")) task-names (dry-run?) (doc-line-of "task-say") (doc-line-of "no-such-task"))
expect result equals ("a b" ("insert" "say") #f "task-say prints the words it was given as one line, and changes nothing. The function is named for what it is, so it never collides with the narration's say: the task's NAME is \"say\", and the function that runs it is task-say." #f)
expect seconds-under 20

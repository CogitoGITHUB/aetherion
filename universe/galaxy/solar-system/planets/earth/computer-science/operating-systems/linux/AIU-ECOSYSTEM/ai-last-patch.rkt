#lang racket/base
(require racket/file racket/string)
(define f "AIU ECOSYSTEM/ecosystem/entry/ecosystem.rkt")
(define (replace-once text old new)
  (define hits (regexp-match-positions* (regexp-quote old) text))
  (unless (= (length hits) 1) (error (string-append "anchor failed: " old)))
  (string-append (substring text 0 (caar hits)) new (substring text (cdar hits))))
(define text (file->string f))
(unless (string-contains? text "[(equal? verb \"path\")")
  (define a "[(equal? verb \"live\") (do-live root (cdr args))]")
  (define b (string-append a "\n               [(equal? verb \"path\") (for ([n (in-list (cdr args))] #:when (directory-exists? (build-path (prefix-dir) n \"current\" \"bin\"))) (for ([x (in-list (directory-list (build-path (prefix-dir) n \"current\" \"bin\")))]) (displayln (path->string (build-path (prefix-dir) n \"current\" \"bin\" x))))) 0]"))
  (display-to-file (replace-once text a b) f #:exists (quote truncate)))
(display "patched\n")

#+begin_src emacs-lisp
(my/cyberdeck-register-prompt
  :key 'rule-file
  :name 'rule-file
  :label "File Override"
  :contexts '(rule)
  :prompt-fn (lambda ()
               (when (yes-or-no-p "Override destination file for primary topic? ")
                 (let* ((existing (when (file-directory-p my/cyberdeck-rules--rules-directory)
                                    (append (directory-files my/cyberdeck-rules--rules-directory nil "\\.org$")
                                            (directory-files my/cyberdeck-rules--rules-directory nil "[^./]+$"))))
                        (file (completing-read "Destination file: " existing)))
                   file)))
  :to-plist (lambda (val _ctx)
              (when val
                `(:unfoldings (("RULE_FILE" . ,val))))))
#+end_src

** Set Active Directory Command
#+begin_src emacs-lisp
(defun my/cyberdeck-set-active-dir (dir)
  "Set the persistent active directory for note creation.
Interactively, use Dired-style browsing.
With a prefix argument, clear it."
  (interactive
   (if current-prefix-arg
       (list nil)
     (let* ((root (my/cyberdeck-root-dir))
            (default (if my/cyberdeck--active-dir
                         (expand-file-name my/cyberdeck--active-dir root)
                       root))
            (choice (read-directory-name "Active directory: " root default)))
       (list (unless (string-equal choice (file-name-as-directory root))
               (directory-file-name (file-relative-name choice root)))))))
  (if dir
      (setq my/cyberdeck--active-dir (directory-file-name dir))
    (setq my/cyberdeck--active-dir nil))
  (message "Active dir: %s" (or my/cyberdeck--active-dir "(none)")))
#+end_src

** Choose Subdirectory (Core)
Implements the actual browsing/selection used by every caller (prompt-subdir,
dictionary, recipes, AIU Runs). Returns a relative path string ending in
"/" (or "" for ROOT itself), so callers can safely (concat prefix subdir slug).
Free-text input is sanitized (trim, unquote, absolutize-if-inside) so a
pasted quoted path can never create garbage directories.
#+begin_src emacs-lisp
(defun my/cyberdeck--sanitize-dir-token (s)
  "Trim S and strip one layer of surrounding quotes/backticks.
Keeps relative structure (unlike the file-token sanitizer) so
multi-level picks like \"projects/foo\" survive."
  (let ((c (string-trim (or s ""))))
    ;; Char codes, never question-mark-quote literals (boot scanner
    ;; limitation: 34 doublequote, 39 squote, 96 backquote).
    (when (and (>= (length c) 2)
               (let ((f (aref c 0)) (l (aref c (1- (length c)))))
                 (and (memq f '(34 39 96)) (eq f l))))
      (setq c (string-trim (substring c 1 (1- (length c))))))
    c))
(defun my/cyberdeck-choose-subdir (&optional root prompt)
  "Choose a subdirectory under ROOT via an explicit completing-read list.
ROOT defaults to `my/cyberdeck-root-dir'. PROMPT overrides the
default minibuffer prompt. Blank input or selecting ROOT's own path
always returns the empty string (root itself), regardless of how many
subdirectories exist. The admin directory is filtered out entirely --
reserved for internal bookkeeping."
  (let* ((root (file-name-as-directory (or root (my/cyberdeck-root-dir))))
         (root-label (abbreviate-file-name root))
         (subdirs
          (when (file-directory-p root)
            (sort
             (delq nil
                   (mapcar
                    (lambda (f)
                      (let ((name (file-name-nondirectory (directory-file-name f))))
                        (when (and (file-directory-p f)
                                   (not (string-prefix-p "." name))
                                   (not (member name (list "admin" "dictionary"))))
                          (file-name-as-directory name))))
                    (directory-files root t)))
             #'string-lessp)))
  (cands (cons root-label subdirs))
          (raw (completing-read (or prompt "Subdirectory: ")
                               cands nil nil nil nil root-label))
          (choice (my/cyberdeck--sanitize-dir-token raw)))
     (cond ((or (string-empty-p choice)
                (string-equal choice root-label))
            "")
           ((file-name-absolute-p choice)
            (if (string-prefix-p root (expand-file-name choice))
                (let ((rel (file-relative-name
                            (directory-file-name
                             (expand-file-name choice))
                            root)))
                  (if (or (string-equal rel ".")
                          (string-prefix-p ".." rel))
                      ""
                    (file-name-as-directory rel)))
              (message "Outside cyberdeck root; using root")
              ""))
           (t (file-name-as-directory choice)))))

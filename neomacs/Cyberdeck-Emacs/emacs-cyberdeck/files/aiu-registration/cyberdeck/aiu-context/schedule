** Registration

*** Scheduled registration
#+begin_src emacs-lisp
(my/cyberdeck-register-prompt
  :key 'scheduled
  :name 'scheduled
  :label "Scheduled"
  :prompt-fn #'my/cyberdeck-prompt-scheduled
  :contexts '(file heading task)
  :read-current-fn (lambda () (org-entry-get nil "SCHEDULED"))
  :merge-strategy 'replace
  :to-plist (lambda (val ctx)
              (if val
                  (if (eq ctx 'heading)
                      `(:post-apply (,(apply-partially #'my/cyberdeck--heading-schedule-apply val)))
                    `(:unfoldings (("SCHEDULED" . ,val))))
                `(:unfoldings (("SCHEDULED" . "WARNING"))))))
#+end_src


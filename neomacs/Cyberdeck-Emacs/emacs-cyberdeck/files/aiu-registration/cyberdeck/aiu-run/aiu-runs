*** Schema
Two schemas: =routine= requires ROUTINE_TYPE/DOMAIN/TEMPORAL on AIUs
tagged =routine= (but not =session=); =aiu-runs-session= requires the
SESSION_* AIU Contexts on AIUs tagged =session=.

**** Validator factories
Every field validates as required, optionally constrained to a
vocabulary — one factory per shape keeps both schemas terse.
#+begin_src emacs-lisp
(defun my/cyberdeck-aiu-runs--required-validator ()
  "Validator accepting any non-WARNING value."
  (lambda (val _n)
    (if (or (null val) (equal val "WARNING"))
        "missing-required"
      t)))

(defun my/cyberdeck-aiu-runs--member-validator (allowed bad-msg)
  "Validator requiring a non-WARNING member of ALLOWED."
  (lambda (val _n)
    (cond ((or (null val) (equal val "WARNING")) "missing-required")
          ((not (member val allowed)) bad-msg)
          (t t))))

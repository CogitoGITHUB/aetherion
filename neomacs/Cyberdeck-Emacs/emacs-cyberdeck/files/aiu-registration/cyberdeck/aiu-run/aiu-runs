(defvar my/cyberdeck-aiu-runs--step-timings nil
  "Alist of (SOURCE-ID ELAPSED PLANNED GRADE) for the current run.
GRADE is `next/`fail when the step was graded, else nil.")

(defun my/cyberdeck-aiu-runs--run-step (buf entry step total)
  "Interactively run ENTRY as step STEP of TOTAL in review BUF."
  (let* ((sid (nth 0 entry))
         (stitle (nth 1 entry))
         (snote (cyberdeck-db-get-by-id sid))
         (mastery (my/cyberdeck-aiu-runs--mastery-status sid))
         (badge (car mastery))
         (due-p (cdr mastery))
         (planned (cyberdeck-timer-parse-duration (nth 9 entry)))
         (t0 (cyberdeck-timer-stopwatch-start))
         (base-choices (if due-p '(?l ?r ?d ?s ?o ?q) '(?d ?s ?o ?q)))
         (choices (append base-choices
                          (when planned '(?t ?+ ?-))))
         (prompt
          (concat (format "[%d/%d] %s%s — "
                          step total stitle
                          (if badge (format " [%s]" badge) ""))
                  (if due-p
                      "l=learn+done r=review-only d=done s=skip o=open q=quit: "
                    "d=done s=skip o=open q=quit: "))))
    (when planned
      (cyberdeck-timer-countdown-start planned)
      (setq prompt (concat prompt "t=pause +=+1m -=-1m: ")))
    (my/cyberdeck-aiu-runs--display-step
     buf step total stitle sid badge planned
     (and planned (cyberdeck-timer-countdown-remaining)))
    (let ((done nil)
          (answer nil))
      (while (not done)
        (setq answer (read-char-choice prompt choices))
        (pcase answer
          (?t (condition-case nil
                  (cyberdeck-timer-countdown-toggle-pause)
                (error (message "No active countdown")))
              (my/cyberdeck-aiu-runs--display-step
               buf step total stitle sid badge planned
               (cyberdeck-timer-countdown-remaining)))
          (?+ (setq planned (+ (or planned 0) 60))
              (cyberdeck-timer-countdown-start
               (+ (or (cyberdeck-timer-countdown-remaining) 0) 60))
              (my/cyberdeck-aiu-runs--display-step
               buf step total stitle sid badge planned
               (cyberdeck-timer-countdown-remaining)))
          (?- (setq planned (max 0 (- (or planned 0) 60)))
              (cyberdeck-timer-countdown-start
               (max 0 (- (or (cyberdeck-timer-countdown-remaining) 0) 60)))
              (my/cyberdeck-aiu-runs--display-step
               buf step total stitle sid badge planned
               (cyberdeck-timer-countdown-remaining)))
          (_ (setq done t))))
      (let ((elapsed (cyberdeck-timer-stopwatch-elapsed t0))
            (grade nil)
            (result nil))
        (cyberdeck-timer-countdown-stop)
        (setq result
              (pcase answer
                (?l (setq grade (my/cyberdeck-aiu-runs--grade-step sid))
                    '(done . t))
                (?r (setq grade (my/cyberdeck-aiu-runs--grade-step sid))
                    (message "Reviewed without marking practice.") nil)
                (?d '(done . nil))
                (?s '(skip . nil))
                (?o (let ((res (my/cyberdeck-aiu-runs--open-followup
                                snote sid due-p)))
                      (cond ((eq res 'quit) 'quit)
                            ((eq res 'done-learn)
                             (setq grade (my/cyberdeck-aiu-runs--grade-step sid))
                             '(done . t))
                            (res (cons res nil))
                            (t nil))))
                (?q 'quit)))
        (push (list sid elapsed planned grade)
              my/cyberdeck-aiu-runs--step-timings)
        result))))

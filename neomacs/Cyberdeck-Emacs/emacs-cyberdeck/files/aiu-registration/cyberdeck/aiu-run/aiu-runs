**** Streak counting
#+begin_src emacs-lisp
(defun my/cyberdeck-aiu-runs--streak-for (aiu-run-id &optional temporal)
  "Consecutive-period streak of ROUTINE-ID ending this or the previous
period. The period derives from TEMPORAL (day by default; week, month,
quarter/season, or year for the matching temporal contexts)."
  (let* ((unit (my/cyberdeck-aiu-runs--streak-unit temporal))
         (buckets (delete-dups
                   (sort (mapcar (lambda (row)
                                   (my/cyberdeck-aiu-runs--bucket
                                    (nth 0 row) unit))
                                 (my/cyberdeck-aiu-runs--sessions-for
                                  aiu-run-id))
                         #'>)))
         (today-int (my/cyberdeck-aiu-runs--datestring-int
                     (my/cyberdeck-aiu-runs--today-string)))
         (anchor (my/cyberdeck-aiu-runs--bucket today-int unit))
         (streak 0))
    (when buckets
      (cond ((= (car buckets) anchor))
            ((= (car buckets) (1- anchor)) (setq anchor (car buckets)))
            (t (setq buckets nil)))
      (while (and buckets (= (car buckets) anchor))
        (setq streak (1+ streak)
              anchor (1- anchor)
              buckets (cdr buckets))))
    streak))

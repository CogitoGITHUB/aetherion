(defun my/cyberdeck-aiu-runs--streak-unit (temporal)
  "Map TEMPORAL context to a streak period unit."
  (pcase temporal
    ("WEEKLY" 'week)
    ("MONTHLY" 'month)
    ((or "QUARTERLY" "SEASONAL") 'quarter)
    ("YEARLY" 'year)
    (_ 'day)))

(defun my/cyberdeck-aiu-runs--bucket (date-int unit)
  "Bucket YYYYMMDD DATE-INT into an ordinal of UNIT."
  (let* ((y (/ date-int 10000))
         (m (% (/ date-int 100) 100))
         (d (% date-int 100))
         (days (time-to-days (encode-time 0 0 0 d m y))))
    (pcase unit
      ('week (/ days 7))
      ('month (+ (* y 12) m))
      ('quarter (+ (* y 4) (1+ (/ (1- m) 3))))
      ('year y)
      (_ days))))

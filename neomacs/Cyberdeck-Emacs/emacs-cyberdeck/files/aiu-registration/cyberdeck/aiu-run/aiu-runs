(defun my/cyberdeck-aiu-runs--session-insert-steps (results file)
  "Delete old entry headings and insert RESULTS as fresh ones.
RESULTS are (source-id title result elapsed planned grade); the
journal line carries timing and learn-grade, and raw seconds land in
STEP_ELAPSED and STEP_PLANNED AIU Contexts for queries."
  (org-with-point-at 1
    (org-back-to-heading t)
    (while (re-search-forward "^\\*\\* " nil t)
      (org-back-to-heading t)
      (let ((beg (point)))
        (org-end-of-subtree t t)
        (delete-region beg (point))))
    (goto-char (point-max))
    (dolist (res results)
      (unless (bolp) (insert "\n"))
      (let ((eid (org-id-new)))
        (insert (format "** %s\n:PROPERTIES:\n:ID: %s\n:SOURCE: %s\n:STEP_RESULT: %s\n%s%s%s:END:\n%s%s\n"
                        (nth 1 res) eid (nth 0 res)
                        (symbol-name (nth 2 res))
                        (if (nth 3 res)
                            (format ":STEP_ELAPSED: %d\n" (nth 3 res))
                          "")
                        (if (nth 4 res)
                            (format ":STEP_PLANNED: %d\n" (nth 4 res))
                          "")
                        (if (nth 5 res)
                            (format ":STEP_GRADE: %s\n" (nth 5 res))
                          "")
                        (cyberdeck-timer-format-step-line
                         (nth 1 res) (nth 2 res) (nth 3 res) (nth 4 res))
                        (if (nth 5 res)
                            (format " · learned %s" (nth 5 res))
                          "")))

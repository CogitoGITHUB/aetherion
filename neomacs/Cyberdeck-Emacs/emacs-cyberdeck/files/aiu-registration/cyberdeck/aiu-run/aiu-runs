(defun my/cyberdeck-aiu-runs-run (&optional routine)
  "Execute ROUTINE (or prompt for one) step by step in a review buffer.
Steps that are in the mastering pool show their review status; due
steps can be graded with r (learn) before being practiced. Steps
with STEP_DURATION run a countdown (t pauses, +/- nudge a minute);
the whole run is stopwatched and per-step times land in the session
journal. Done entries advance their reschedule anchors. At the
end, offer to journal the session."
  (interactive)
  (let* ((routine (or routine
                      (my/cyberdeck-aiu-runs--select-aiu-run-interactive
                       "Run AIU Run: ")))
         (entries (my/cyberdeck-aiu-runs--entries routine)))
    (unless entries (user-error "AIU Run has no entries"))
    (let ((buf (get-buffer-create "*cyberdeck-aiu-runs-run*"))
          (total (length entries))
          (done 0)
          (skipped 0)
          (learned 0)
          (step 0)
          (results nil)
          (my/cyberdeck-aiu-runs--step-timings nil)
          (t0 (cyberdeck-timer-stopwatch-start)))
      (with-current-buffer buf
        (special-mode)
        (setq buffer-read-only t))
      (pop-to-buffer-same-window buf)
      (catch 'aiu-runs-quit
        (dolist (entry entries)
          (setq step (1+ step))
          (let ((res (my/cyberdeck-aiu-runs--run-step
                      buf entry step total)))
            (cond
             ((eq res 'quit) (throw 'aiu-runs-quit nil))
             (res
              (pcase (car res)
                ('done (setq done (1+ done)))
                ('skip (setq skipped (1+ skipped))))
              (when (cdr res) (setq learned (1+ learned)))
              (push (my/cyberdeck-aiu-runs--attach-timing
                     (nth 0 entry) (nth 1 entry) (car res))
                    results))))))
      (kill-buffer buf)
      (cyberdeck-timer-countdown-stop)
      (let ((elapsed (cyberdeck-timer-stopwatch-elapsed t0)))
        (when results
          (my/cyberdeck-aiu-runs--advance-anchors
           routine (nreverse results)))
        (when (and results
                   (y-or-n-p (format "Log session (%d done / %d skipped / %d learned)? "
                                     done skipped learned)))
          (my/cyberdeck-aiu-runs--session-create
           routine (nreverse results) done skipped elapsed))
        (message "AIU Run finished: %d done, %d skipped, %d learned in %s"
                 done skipped learned
                 (cyberdeck-timer-format-seconds elapsed))))))

       (goto-char (point-max))
       (unless (bolp) (insert "\n"))
       (insert (format "%s\n"
                       (cyberdeck-timer-format-session-line
                        done skipped total elapsed)))
       (save-buffer))
    (my/cyberdeck-aiu-runs--session-db-upsert sid rid today done skipped total)
    (message "Session logged: %s (%d done / %d skipped)"
             (cyberdeck-aiu-title note) done skipped)
    note))


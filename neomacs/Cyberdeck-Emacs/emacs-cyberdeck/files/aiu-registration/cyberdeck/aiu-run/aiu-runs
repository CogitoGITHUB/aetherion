(defun my/cyberdeck-aiu-runs--render-entry (entry gindex)
  "Return the AIU Proxy text for ENTRY against GINDEX."
  (let* ((sid (nth 0 entry))
         (stitle (nth 1 entry))
         (group (nth 3 entry))
         (sets (nth 4 entry)) (reps (nth 5 entry))
         (load (nth 6 entry)) (rest (nth 7 entry))
         (rx (nth 8 entry))
         (tid (or (and gindex (cdr (assoc sid gindex))) sid))
         (rxline (cond ((and sets reps)
                        (concat sets "x" reps
                                (and load (format " @%s" load))
                                (and rest (format " /%ss" rest))))
                       (rx rx)))
         (label (delq nil (list group rxline))))
    (concat (format "#+wormhole: [[id:%s][%s]] :level 2\n" tid stitle)
            (when label
              (concat "- " (string-join label " — ") "\n")))))

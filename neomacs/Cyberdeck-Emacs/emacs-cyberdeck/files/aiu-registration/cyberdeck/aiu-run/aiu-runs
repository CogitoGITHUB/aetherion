*** DB Extractor
Indexes ROUTINE_* AIU Contexts from NOTE-DATA. AIU Run AIUs land in
=routines=; entry headings carrying ROUTINE_ID, SOURCE and
ROUTINE_ORDER land in =routine_entries=. Session AIUs with SESSION_OF
and SESSION_DATE land in =routine_sessions=.

**** AIU Run row extraction
#+begin_src emacs-lisp
(defun my/cyberdeck-aiu-runs--extract-aiu-run (aiu-id unfoldings)
  "Index the AIU Run row for NOTE-ID from PROPS."
  (let ((rtype (cdr (assoc "ROUTINE_TYPE" unfoldings))))
    (emacsql (cyberdeck-db)
      [:delete :from routines :where (= aiu-id $s1)]
      aiu-id)
    (when (and rtype
               (not (string-equal rtype "WARNING"))
               (member rtype my/cyberdeck-aiu-runs--types))
      (emacsql (cyberdeck-db)
        [:insert :into routines :values $v1]
        (vector aiu-id rtype
                (cdr (assoc "ROUTINE_DOMAIN" unfoldings))
                (cdr (assoc "ROUTINE_TEMPORAL" unfoldings)))))))
#+end_src

(defun my/cyberdeck-aiu-runs--pick-members (candidates)
  "Completing-read chain members from CANDIDATES until empty input."
  (let ((picked nil) (go t))
    (while go
      (let* ((prompt (if picked
                         (format "Chain member %d (empty input finishes): "
                                 (1+ (length picked)))
                       "First chain member (empty input aborts): "))
             (choice (completing-read prompt (mapcar #'car candidates) nil nil))
             (cell (assoc choice candidates)))
        (if (string-empty-p choice)
            (setq go nil)
          (when (and cell (not (member (cdr cell) picked)))
            (push (cdr cell) picked)))))
  (nreverse picked)))

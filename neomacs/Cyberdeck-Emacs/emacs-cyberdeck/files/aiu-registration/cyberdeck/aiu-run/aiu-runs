(defun my/cyberdeck-aiu-runs--session-create (routine results done skipped elapsed)
  "Create or update today's session note for ROUTINE.
RESULTS is a list of (source-id title result elapsed planned grade),
result being `done or `skip. ELAPSED is whole-run wall seconds."
  (let* ((rid (cyberdeck-aiu-id routine))
         (rtitle (cyberdeck-aiu-title routine))
         (date (my/cyberdeck-aiu-runs--today-string))
         (today (my/cyberdeck-aiu-runs--datestring-int date))
         (total (length results))
         (fname (my/cyberdeck-aiu-runs--session-path
                 date (cyberdeck-title-to-slug rtitle)))
          (unfoldings `(("SESSION_OF" . ,rid)
                   ("SESSION_DATE" . ,date)
                   ("SESSION_DONE" . ,(number-to-string done))
                   ("SESSION_SKIPPED" . ,(number-to-string skipped))
                   ("SESSION_TOTAL" . ,(number-to-string total))
                   ("SESSION_ELAPSED" . ,(number-to-string elapsed))))
          (note (or (my/cyberdeck-aiu-runs--session-aiu-for rid today)
                    (my/cyberdeck--create-file-wrapper
                     (format "%s — %s" rtitle date)
                     fname '("session") unfoldings "")))
          (file (cyberdeck-aiu-path note))
          (sid (cyberdeck-aiu-id note)))
     (with-current-buffer (find-file-noselect file)
       (org-with-point-at 1
         (org-back-to-heading t)
         (dolist (unfolding unfoldings)
           (org-entry-put nil (car unfolding) (cdr unfolding))))
       (my/cyberdeck-aiu-runs--session-insert-steps results file)
       (goto-char (point-min))
       (while (re-search-forward "^Session: [0-9]+ done / .*$" nil t)

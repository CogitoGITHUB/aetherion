(defun my/cyberdeck-aiu-runs-due-reviews ()
  "Create or refresh the \"Due Reviews\" composite routine from
today's due mastering notes.  Stable ID across refreshes; renders
like any other AIU Run and appears in streaks/report."
  (interactive)
  (let ((ids (my/cyberdeck-installation-protocol--due-aiu-ids)))
    (when (null ids) (user-error "Nothing due today"))
    (let* ((title "Due Reviews")
           ;; Reuse an existing Due Reviews AIU Run if present.
           (rows (emacsql (cyberdeck-db)
                          [:select [routines:aiu-id notes:title]
                           :from routines
                           :inner :join notes :on (= routines:aiu-id notes:id)]))
           (rid (cl-loop for row in rows
                         when (string-equal (cadr row) title)
                         return (car row)))
           (note (if rid
                     (cyberdeck-db-get-by-id rid)
                   (my/cyberdeck--create-file-wrapper
                    title
                    (concat "routines/due-reviews")
                    '("AIU Run")
                    '(("ROUTINE_TYPE" . "composite"))
                    "")))
           (items (mapcar (lambda (id)
                            (let ((n (cyberdeck-db-get-by-id id)))
                              (cons id (if n (cyberdeck-aiu-title n)
                                         id))))
                          ids))
           (ordered (my/cyberdeck-aiu-runs--reorder items))
           (details (my/cyberdeck-aiu-runs--prompt-details ordered)))
      (unless details (user-error "Aborted"))
      (my/cyberdeck-aiu-runs--clear-entry-headings note)
      (my/cyberdeck-aiu-runs--write-entries note details)
      (my/cyberdeck-aiu-runs-generate note)
      (message "Due Reviews refreshed (%d entries)" (length details))
      note)))

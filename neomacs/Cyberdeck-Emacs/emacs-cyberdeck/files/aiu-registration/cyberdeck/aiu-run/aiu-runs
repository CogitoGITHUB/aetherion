#+begin_src emacs-lisp
(defun my/cyberdeck-aiu-runs--write-entries (note items)
  "Append ITEMS as entry child headings of NOTE.
ITEMS are (id title group rx duration interval days) lists from
`--prompt-details'. Dual-writes: org drawer unfoldings plus
immediate routine_entries rows."
  (let* ((file (cyberdeck-aiu-path note))
         (aiu-run-id (cyberdeck-aiu-id note))
         (idx 0))
    (with-current-buffer (find-file-noselect file)
      (goto-char (point-max))
      (dolist (item items)
        (setq idx (1+ idx))
        (unless (bolp) (insert "\n"))
        (let ((eid (org-id-new)))
          (insert (my/cyberdeck-aiu-runs--entry-text
                   (nth 1 item) eid (nth 0 item) aiu-run-id idx
                   (nth 2 item) (nth 3 item)
                   (nth 4 item) (nth 5 item) (nth 6 item)))
          (org-id-add-location eid file)
          (my/cyberdeck-aiu-runs--entry-insert-row
           eid aiu-run-id (nth 0 item) idx (nth 2 item)
           (nth 4 item) (nth 5 item) (nth 6 item))))
      (save-buffer))))

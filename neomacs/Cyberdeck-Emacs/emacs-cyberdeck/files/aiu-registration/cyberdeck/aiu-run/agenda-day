(defun my/cyberdeck-agenda-day ()
  "Cross-engine due surface: routines + protocols due, streak strips.
Installation Protocol shows only as a due count (run Due Reviews to practice)."
  (interactive)
  (let ((entries (my/cyberdeck-agenda--due-entries))
        (protos (my/cyberdeck-agenda--due-protocols))
        (today (format-time-string "%Y-%m-%d")))
    (with-current-buffer (get-buffer-create "*cyberdeck-day*")
      (erase-buffer)
      (org-mode)
      (insert (format "* Cyberdeck Day — %s\n\n" today))
      (insert "** AIU Runs due\n")
      (if (null entries)
          (insert "- nothing due\n")
        (let ((last-rid nil))
          (dolist (e entries)
            (unless (equal (nth 0 e) last-rid)
              (setq last-rid (nth 0 e))
              (insert (format "- %s  streak %s\n"
                              (nth 1 e)
                              (if (fboundp 'my/cyberdeck-aiu-runs--streak-strip)
                                  (my/cyberdeck-aiu-runs--streak-strip
                                   last-rid)
                                "—"))))
            (insert (format "  - [[id:%s][%s]]%s\n"
                            (nth 3 e) (nth 2 e)
                            (if (nth 5 e)
                                (format "  (%s planned)" (nth 5 e))
                              ""))))))
      (insert "\n** Protocols due\n")
      (if (null protos)
          (insert "- nothing due\n")
        (dolist (p protos)
          (insert (format "- [[id:%s][%s]]\n" (nth 0 p) (nth 1 p)))))
      (insert "\n** Installation Protocol\n")
      (insert (format "- due notes: %s (run Due Reviews to practice)\n"
                      (if (fboundp 'my/cyberdeck-installation-protocol--due-count)
                          (number-to-string
                           (my/cyberdeck-installation-protocol--due-count))
                        "—")))
      (insert "\n** Agenda\n- [[elisp:(org-agenda-list)][open org agenda for today]]\n")
      (goto-char (point-min))
      (display-buffer (current-buffer)))
    (message "Cyberdeck day: %d entries, %d protocols due"
             (length entries) (length protos))))
#+end_src

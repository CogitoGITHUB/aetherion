(defun my/cyberdeck-agenda--today-int ()
  "Today as YYYYMMDD integer."
  (string-to-number (format-time-string "%Y%m%d")))

(defun my/cyberdeck-agenda--due-entries ()
  "Routine entries due: NEXT_DATE set and on-or-before today.
Returns (ROUTINE-ID ROUTINE-TITLE ENTRY-TITLE SOURCE-ID NEXT PLANNED)
rows ordered by AIU Run then entry order."
  (let ((today (my/cyberdeck-agenda--today-int))
        (out nil))
    (dolist (row (condition-case nil
                    (emacsql (cyberdeck-db)
                      [:select [aiu-run-id source-id next-date step-duration entry-order]
                       :from routine_entries
                       :where (<= next-date $s1)
                       :order :by [aiu-run-id entry-order]]
                      today)
                  (error nil)))
      (let* ((rid (nth 0 row))
             (rnote (cyberdeck-db-get-by-id rid))
             (snote (cyberdeck-db-get-by-id (nth 1 row))))
        (push (list rid
                    (if rnote (cyberdeck-aiu-title rnote) rid)
                    (if snote (cyberdeck-aiu-title snote) (nth 1 row))
                    (nth 1 row) (nth 2 row) (nth 3 row))
              out)))
    (nreverse out)))

(defun my/cyberdeck-agenda--due-protocols ()
  "Protocol parents due: PNEXT set and on-or-before today.
Returns (NOTE-ID TITLE PNEXT) rows."
  (let ((today (my/cyberdeck-agenda--today-int))
        (out nil))
    (dolist (row (condition-case nil
                    (emacsql (cyberdeck-db)
                      [:select [aiu-id pnext] :from protocols
                       :where (<= pnext $s1)]
                      today)
                  (error nil)))
      (let ((note (cyberdeck-db-get-by-id (nth 0 row))))
        (push (list (nth 0 row)
                    (if note (cyberdeck-aiu-title note) (nth 0 row))
                    (nth 1 row))
              out)))
    (nreverse out)))

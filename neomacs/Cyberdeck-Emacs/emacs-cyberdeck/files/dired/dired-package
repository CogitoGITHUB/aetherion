(defun my/dired-here ()
  "Open dired at the current buffer's directory."
  (interactive)
  (dired (expand-file-name
          (or (and buffer-file-name
                   (file-name-directory buffer-file-name))
              default-directory))))
(defun my/dired-find-file ()
  "Open file at point, guarding against nil (header lines etc.)."
  (interactive)
  (let ((file (ignore-errors (dired-get-filename nil t))))
    (if file
        (find-file file)
      (message "No file on this line"))))
(defun my/dired-ks-open-file ()
  "Select a dired line with key selection and open the file directly."
  (interactive)
  (ks-with my/dired-ks-open-file
    (let ((r (ks--line (eq current-prefix-arg 4))))
      (when (and (not (memq r '(t nil))) (eq ks-action #'identity))
        (goto-char r)
        (my/dired-find-file)))))

** Purpose
Groups agenda items by category, priority, tag, or custom predicates.
Transforms a flat todo list into something navigable across hundreds of
items and many files.

** Setup

*** Config
#+begin_src emacs-lisp
(setq org-agenda-span 'week)
(setq org-agenda-start-on-weekday 1)
(setq org-agenda-window-setup 'current-window)
(setq org-agenda-skip-scheduled-if-done t)
(setq org-agenda-skip-deadline-if-done t)

;; org-todo-keywords is owned by `org-todo-states.org', which derives it
;; from the Cyberdeck TODO AIU context. Setting it here used to win by load
;; order (MM_ORDER 194 > 107) and silently truncate the vocabulary.

(let ((message-log-max nil))
  (let ((inhibit-message t)) (org-super-agenda-mode 1)))

(setq org-super-agenda-groups
      '((:name "Today"
         :time-grid t
         :date today
         :scheduled today
         :order 1)
        (:name "High Priority"
         :priority "A"
         :order 2)
        (:name "In Progress"
         :todo "DOING"
         :order 3)
        (:name "Guix"
         :tag "guix"
         :order 4)
        (:name "MappingOS"
         :tag "mappingos"
         :order 5)
        (:name "Emacs"
         :tag "emacs"
         :order 6)

;;──────────────────────────────────────────────────────────
;; Desktop save location
;;──────────────────────────────────────────────────────────
;; Kept in the vault's admin/ beside the databases, with the order files,
;; rather than in ~/.config/emacs — a session is vault state, not config,
;; and admin/ is excluded from unit discovery so nothing here is compiled.
;;
;; Absolute, not "~/.config/...": `desktop-dirname' is used as a path by
;; desktop.el and a literal tilde in it is not expanded, so the old value
;; would have made a directory actually named "~" under whatever the
;; current directory happened to be.
(defvar my/desktop-dir
  (file-name-as-directory
   (expand-file-name "admin/desktop" cyberdeck-emacs-vault-root))
  "Directory holding the Emacs desktop file.")

(make-directory my/desktop-dir t) ;; ensure directory exists

